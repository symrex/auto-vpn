# autoVPN — copy to .env, then: chown root:root .env && chmod 600 .env
# Never commit .env. Values shown are placeholders, NOT real secrets.

# provider's VPN username (without domain suffix)
VPN_USER=

# login password (NOT the MFA one-time password)
VPN_PASSWORD=

# TOTP secret as base32 (from the MFA setup) OR a full otpauth:// URI.
# OTPAUTH_URI wins if both are set.
TOTP_SECRET=BASE32SECRETPLACEHOLDER
# OTPAUTH_URI=otpauth://totp/VPN?secret=BASE32SECRETPLACEHOLDER&algorithm=SHA1&digits=6&period=30

# TOTP parameters (provider standard is usually: sha1 / 30s / 6 digits)
TOTP_ALGO=sha1
TOTP_PERIOD=30
TOTP_DIGITS=6

# path to the OpenVPN config
OPENVPN_CONFIG=/opt/autovpn/openvpn-client.ovpn

# tmpfs target of the generated auth file (built by autovpn.py, 600 root)
AUTH_FILE=/run/autovpn/auth.txt

# auth fallback chain:
#   A = auth-user-pass pass-file: line1 user, line2 password+token (config:
#       'auth-user-pass /run/autovpn/auth.txt' + route-up refresh)
#   B = auth-user-pass-verify via-env (UDF script)
#   C = management prompt responder — for static-challenge/OpenVPN 2.6 the PRAXIS mode:
#       static-challenge answers must NOT come from the auth file
#       (OpenVPN 2.6 fetches them exclusively via the management interface).
#       Required in the config: 'auth-user-pass' (without file path!),
#       'management /run/autovpn/mgmt.sock unix' + 'management-query-passwords'.
#       The responder supplies 'password Auth SCRV1:b64(pw):b64(token)' — the
#       token is minted per prompt (age < 30 s).
VPN_AUTH_MODE=C
# pass-file format (mode A): concat = user / password+token (default)
#                            3line   = user / password / token
#                            userfile= user only (challenge runs via mode C)
VPN_AUTH_FORMAT=concat
# unix socket of the OpenVPN management interface (mode C)
MGMT_SOCKET=/run/autovpn/mgmt.sock

# TCP for the management interface is REFUSED by default: the interface has NO
# password (the design relies on the unix socket being root-exclusive in
# /run/autovpn, mode 700), so a TCP listener would hand username+password+SCRV1
# response to anyone who can reach the port. Set to 1 only for a LOOPBACK target.
# MGMT_ALLOW_TCP=0

# Clock tolerance (both optional; defaults = strict, single current-window code):
# TOTP_CLOCK_OFFSET  seconds added to the local clock, for a host clock that
#                    drifts against the server (clamped to +-600; larger drift
#                    means fix NTP, not shift the clock).
# TOTP_SKEW_WINDOWS  0/1/2 extra FUTURE windows, for a clock running slightly
#                    BEHIND the server. A static-challenge (SCRV1) response can
#                    carry exactly one code, so this only applies to multi-line
#                    prompt answers (VPN_AUTH_FORMAT=3line); mode C's SCRV1
#                    answer always uses the current-window code.
# TOTP_CLOCK_OFFSET=0
# TOTP_SKEW_WINDOWS=0

# watchdog: VPN interface that must exist in the active state
VPN_INTERFACE=tun0
